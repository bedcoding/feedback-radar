# 레포 루트의 .env로 복사해서 쓰세요. 전부 비워 둬도 동작합니다 (기능이 하나씩 꺼질 뿐).
#   Windows: copy .env.example .env
#   macOS  : cp .env.example .env
# .env는 gitignore 대상이라 커밋되지 않습니다. 추적되는 것은 이 예시 파일 하나뿐입니다.

# ── LLM 태깅 모드 ─────────────────────────────────────────────
# 미설정 시 자동 선택: claude CLI(구독, 추가비용 0) → 설정된 API 키 → 휴리스틱
# 강제하려면: cli | openai | anthropic | heuristic
# 예전 TAGGER_MODE=api도 계속 동작하며, 그때는 TAGGER_API_PROVIDER로 공급자를 고릅니다.
TAGGER_MODE=
TAGGER_API_PROVIDER=

# [cli 모드] Claude Code CLI 실행 경로.
# 비워 두면 PATH의 'claude'를 먼저 찾고, 없으면 아래 표준 설치 위치를 자동으로 확인합니다.
#   Windows: %APPDATA%\npm\claude.cmd
#   macOS  : ~/.claude/local/claude, /usr/local/bin/claude, /opt/homebrew/bin/claude
# 그래도 못 찾으면 여기에 전체 경로를 적으세요 (따옴표 없이, 공백 있어도 그대로).
CLAUDE_CLI_CMD=

# [cli 모드] 분류에 쓸 모델. 대시보드 'AI 분류 상태' 카드에서 바꾸면 여기보다 우선합니다.
# haiku/sonnet/opus는 별칭이라 CLI가 최신 버전으로 바꿔 넘깁니다: 실제로 호출된 정식 모델 ID는
# 카드('실제 호출 ...')와 수집 로그에 표시됩니다. 버전을 고정하려면 claude-haiku-4-5 처럼 정식 ID를 적으세요.
# 빈 값은 '계정 기본값'이라는 뜻이라 조직 설정에 따라 거부될 수 있습니다. 기본값(haiku)을 쓰려면 주석인 채로 두세요.
# CLAUDE_CLI_MODEL=haiku

# [Anthropic API] 키만 채우면 된다. 모델 기본값은 claude-haiku-4-5.
ANTHROPIC_API_KEY=
# TAGGER_MODEL=claude-haiku-4-5

# [OpenAI API] 키만 채우면 된다. 모델 기본값은 분류, 추출용 gpt-5.4-nano.
# 모델은 대시보드 'AI 분류 상태' 카드에서 고르고, 그 값이 아래 환경변수보다 우선한다.
# 여기 적어 두면 화면에서 바꾼 뒤에도 남아 있어 어느 쪽이 쓰였는지 헷갈린다.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-nano
# OPENAI_REASONING_EFFORT=none

# ── 수집 소스 ────────────────────────────────────────────────
# 네이버 오픈 API: https://developers.naver.com/apps 에서 무료 발급 (블로그/카페 검색)
# 없으면 네이버 소스만 조용히 건너뜁니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 스케줄 ───────────────────────────────────────────────────
# 스케줄러 기본 주기(시간). 이후에는 대시보드 UI에서 변경
DEFAULT_INTERVAL_HOURS=24

# 대시보드 포트 (기본 3000). 충돌 시 변경
# PORT=3000

# ── 비상용 우회 ──────────────────────────────────────────────
# 테넌트 설정(서비스명, 키워드, 앱 ID, 용어 사전)을 담는 JSON 한 줄.
#
# **평소에는 비워 둔다.** 설정의 원본은 DB(settings의 config 키)이고, 로컬에서 처음
# 실행할 때 파일에서 한 번 옮겨 심는다. 배포본도 같은 값을 읽으므로 따로 넣을 일이 없다.
#
# 이 값을 채우면 DB보다 우선한다. DB에 접속할 수 없는데 화면은 띄워야 하는 상황을 위한
# 탈출구이고, 켜 둔 채로 잊으면 설정 탭에서 저장한 값이 화면에 반영되지 않는다.
RADAR_CONFIG_JSON=

# ── PostgreSQL 중앙 DB ─────────────────────────────────────────────────────
# 접속 정보는 이 한 줄이 전부다. 배포 환경에도 이 변수 하나만 등록하면 된다.
#
#   DATABASE_URL=postgresql://사용자:비밀번호@호스트:5432/DB이름?schema=feedback_radar&sslmode=require
#
# 쿼리로 붙일 수 있는 값 (생략하면 괄호 안이 기본값)
#   schema    앱 전용 스키마 (feedback_radar)
#   sslmode   disable, auto는 TLS 미사용 / require는 암호화 / verify-full은 인증서까지 검증 (require)
#   pool_max  프로세스당 최대 연결 수. 베이직급 호스팅은 동시 연결이 10 안팎이라 서버리스에서는 1 (1)
#
# 비밀번호의 특수문자는 percent-encoding한다: # → %23, / → %2F, ? → %3F. @는 그대로 둬도 된다.
# #을 인코딩하지 않으면 .env 파서가 그 앞에서 값을 잘라, 접속 실패가 아니라 다른 비밀번호로 시도한다.
DATABASE_URL=

# 아래 셋은 URL 쿼리에 안 적었을 때만 쓰이는 보충값이다. 평소에는 비워 둔다.
PGSCHEMA=
PGSSL_MODE=
PGPOOL_MAX=
