{
  "_preset": "커머스 (쇼핑몰·마켓플레이스) — 주문·배송·반품이 핵심인 서비스",
  "_usage": "private/feedback-radar.config.json 으로 복사한 뒤 displayName·keywords·appId 만 채우면 됩니다.",

  "tenant": "myservice",
  "displayName": "{서비스명}",
  "keywords": ["{서비스명}", "{줄임말·별칭}"],

  "appstore": { "appId": "{앱스토어 숫자 ID}", "country": "kr" },
  "googlePlay": { "appId": "{구글플레이 패키지명}", "lang": "ko", "country": "kr" },

  "sources": {
    "appstore": true,
    "googleplay": true,
    "naver": true,
    "dcinside": true,
    "threads": false
  },
  "collect": { "googlePlayReviewCount": 200, "appstorePages": 3, "naverDisplay": 50 },

  "domainPrompt": "- 결제 실패·중복 결제·환불 지연 → 결제/코인, 심각도 high 이상\n- 배송 지연·오배송·파손은 콘텐츠/작품이 아니라 기타로 두되 심각도를 올린다\n- 쿠폰·적립금 미적용 → 이벤트/프로모션\n- 품절·재입고 문의는 심각도 low\n- 판매자(셀러) 응대 불만은 CS 팀",

  "categoryKeywords": {
    "결제/코인": ["적립금", "포인트", "카드", "무통장", "부분취소"],
    "콘텐츠/작품": ["상품", "품질", "정품", "사이즈", "상세페이지"],
    "정책/검열": ["교환", "반품", "환불정책", "규정"],
    "이벤트/프로모션": ["쿠폰", "적립", "특가", "타임세일"],
    "기타": ["배송", "택배", "품절", "재입고", "오배송", "파손"]
  },

  "excludeHints": ["서비스명과 철자가 같은 다른 분야 단어를 여기에 (예: 타 업종 용어)"],

  "relevanceHints": ["주문", "배송", "결제", "상품", "리뷰", "앱"],

  "pitch": { "secondsPerItem": 30, "briefingMinutes": 10 }
}
