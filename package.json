{
  "name": "feedback-radar",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "find-app": "node scripts/find-app.mjs",
    "pack": "node scripts/pack-private.mjs",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/pipeline --noEmit && tsc -p apps/web --noEmit",
    "dev": "concurrently -n web,scheduler -c cyan,yellow \"npm run dev -w @feedback-radar/web\" \"npm run scheduler -w @feedback-radar/pipeline\"",
    "build": "npm run build -w @feedback-radar/web",
    "start": "concurrently -n web,scheduler -c cyan,yellow \"npm run start -w @feedback-radar/web\" \"npm run scheduler -w @feedback-radar/pipeline\"",
    "collect": "npm run daily -w @feedback-radar/pipeline --",
    "collect:heuristic": "npm run daily -w @feedback-radar/pipeline -- --heuristic",
    "scheduler": "npm run scheduler -w @feedback-radar/pipeline",
    "retag": "npm run retag -w @feedback-radar/pipeline --",
    "dev:web": "npm run dev -w @feedback-radar/web",
    "deck": "npm run deck -w @feedback-radar/pipeline --",
    "x-login": "npm run x-login -w @feedback-radar/pipeline",
    "clean-dupes": "npm run clean-dupes -w @feedback-radar/pipeline --",
    "backfill": "npm run backfill -w @feedback-radar/pipeline --",
    "prune-summaries": "npm run prune-summaries -w @feedback-radar/pipeline --"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
